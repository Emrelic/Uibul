<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- ── Sürüm ────────────────────────────────────────────────────────────
         Tek doğruluk kaynağı burasıdır. UpdateService bu değeri assembly'den
         okuyup GitHub'daki en son release etiketiyle karşılaştırır.
         Yeni sürüm çıkarırken: burayı artır → tools\yeni-surum.ps1 çalıştır. -->
    <Version>3.1.0</Version>
    <AssemblyVersion>3.1.0.0</AssemblyVersion>
    <FileVersion>3.1.0.0</FileVersion>
    <Product>UIBUL - Universal UI Element Inspector</Product>
    <Company>UIBUL</Company>
    <Authors>Emrelic</Authors>
    <Copyright>Copyright © 2026 Emrelic</Copyright>
    <Description>Windows uygulamaları ve tarayıcılar için UI element inceleme, yakalama ve ekran görüntüsü aracı</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Content Include="Resources\app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <!-- Playwright temporarily removed due to network issues -->
    <!-- <PackageReference Include="Microsoft.Playwright" Version="1.40.0" /> -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- UI Automation references are included in .NET framework -->

</Project>
