<Window x:Class="UIElementInspector.Windows.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UIBUL — Öğretici" Height="720" Width="1080"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SOL: bölüm listesi ══ -->
        <Border Grid.Column="0" Background="#263238">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,20,18,14">
                    <TextBlock Text="🎓 ÖĞRETİCİ" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Name="txtSurumEtiketi" Text="UIBUL" Foreground="#78909C"
                               FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="listBolumler" Margin="0,0,0,10"/>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#1C262B" Padding="18,12">
                    <StackPanel>
                        <TextBlock Name="txtIlerlemeMetni" Text="1 / 1" Foreground="#B0BEC5" FontSize="11"/>
                        <ProgressBar Name="pbIlerleme" Height="5" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                     Foreground="#4CAF50" Background="#37474F" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ SAĞ: içerik ══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    Padding="30,20,30,18">
                <StackPanel>
                    <TextBlock Name="txtBolumEtiketi" Text="BÖLÜM" FontSize="10.5" FontWeight="Bold"
                               Foreground="#1565C0" Margin="0,0,0,5"/>
                    <TextBlock Name="txtBaslik" Text="Başlık" FontSize="23" FontWeight="Bold"
                               Foreground="#212121" TextWrapping="Wrap"/>
                    <TextBlock Name="txtOzet" Text="" FontSize="13" Foreground="#616161"
                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Name="scrollIcerik" VerticalScrollBarVisibility="Auto"
                          Padding="30,22,30,22">
                <StackPanel Name="pnlIcerik"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                    Padding="30,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <CheckBox Name="chkTekrarGosterme" Content="Açılışta bir daha gösterme"
                                  VerticalAlignment="Center" Foreground="#666" FontSize="12"
                                  Click="TekrarGosterme_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="btnGeri" Content="◀ Geri" Click="Geri_Click"
                                Padding="16,8" Margin="0,0,8,0" Background="Transparent"
                                BorderBrush="#BDBDBD" BorderThickness="1" Foreground="#555" FontSize="12"/>
                        <Button Name="btnIleri" Content="İleri ▶" Click="Ileri_Click"
                                Padding="22,8" Background="#1565C0" Foreground="White"
                                BorderThickness="0" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
