<Window x:Class="UIElementInspector.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güncelleme" Height="520" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinHeight="420" MinWidth="520"
        Background="#FAFAFA">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,16">
            <StackPanel>
                <TextBlock Text="🔄 Güncelleme" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Name="txtAltBaslik" Text="Yeni sürüm aranıyor…" FontSize="12"
                           Foreground="#BBDEFB" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Sürüm özeti -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="KURULU SÜRÜM" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock Name="txtMevcutSurum" Text="—" FontSize="18" FontWeight="Bold" Foreground="#424242"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="→" FontSize="22" Foreground="#BDBDBD"
                           VerticalAlignment="Center" Margin="16,0"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="YENİ SÜRÜM" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock Name="txtYeniSurum" Text="—" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                    <TextBlock Name="txtYeniBoyut" Text="" FontSize="11" Foreground="#888"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sürüm notları / durum -->
        <Border Grid.Row="2" Margin="20,16,20,0" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ScrollViewer Name="scrollNotlar" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <TextBlock Name="txtNotlar" TextWrapping="Wrap" FontSize="12.5"
                               LineHeight="20" Foreground="#333"/>
                </ScrollViewer>

                <!-- Kontrol sürerken -->
                <StackPanel Name="pnlBekleme" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="34" HorizontalAlignment="Center"/>
                    <TextBlock Name="txtBekleme" Text="GitHub'a bağlanılıyor…"
                               Margin="0,10,0,0" Foreground="#666" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- İndirme ilerlemesi -->
        <StackPanel Grid.Row="3" Name="pnlIndirme" Margin="20,14,20,0" Visibility="Collapsed">
            <Grid Margin="0,0,0,5">
                <TextBlock Name="txtIndirmeDurum" Text="İndiriliyor…" FontSize="12" Foreground="#555"/>
                <TextBlock Name="txtIndirmeYuzde" Text="0%" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Right" Foreground="#1565C0"/>
            </Grid>
            <ProgressBar Name="pbIndirme" Height="8" Minimum="0" Maximum="100"
                         Foreground="#1565C0" Background="#E0E0E0" BorderThickness="0"/>
        </StackPanel>

        <!-- Düğmeler -->
        <Border Grid.Row="4" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="20,14" Margin="0,16,0,0">
            <Grid>
                <Button Name="btnDepoyuAc" Content="GitHub'da aç" Click="DepoyuAc_Click"
                        HorizontalAlignment="Left" Padding="12,7" Background="Transparent"
                        BorderBrush="#BDBDBD" BorderThickness="1" Foreground="#555" FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="btnAtla" Content="Bu sürümü atla" Click="Atla_Click"
                            Padding="12,7" Margin="0,0,8,0" Background="Transparent"
                            BorderBrush="#BDBDBD" BorderThickness="1" Foreground="#555"
                            FontSize="12" Visibility="Collapsed"/>
                    <Button Name="btnSonra" Content="Kapat" Click="Sonra_Click"
                            Padding="16,7" Margin="0,0,8,0" Background="Transparent"
                            BorderBrush="#BDBDBD" BorderThickness="1" Foreground="#555" FontSize="12"/>
                    <Button Name="btnGuncelle" Content="⬇ Şimdi güncelle" Click="Guncelle_Click"
                            Padding="18,7" Background="#2E7D32" Foreground="White"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
